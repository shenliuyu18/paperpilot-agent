# The Dockerfile ends with `COPY . .`, so this list is what keeps a user's own research
# data out of a self-built image: uploaded PDFs, their parsed text, projects, agent runs,
# search history, glossaries, the model-call audit log and stored API keys.
#
# Demo fixtures stay in (data/demo_pdfs, data/parsed/2*, data/cache/crossref_fixture.json,
# data/eval, data/eval_set.json, data/eval_results.json) — they are what the bundled demo
# and the 评测 page read at runtime.

# secrets and model configuration, wherever they live
.secrets/
*.env
!*.env.example
data/llm_settings.json
data/llm_settings.secrets.json
data/custom_sources.secrets.json
data/llm_calls.json

# user research data
data/uploads/
data/parsed/upload-*
data/projects/
data/projects.json
data/agent_runs/
data/agent_runs.json
data/search_history.json
data/subscriptions.json
data/library.json
data/glossaries/
data/locks/
data/cache/*
!data/cache/crossref_fixture.json

# development-only trees; the running app reads none of these
tests/
scripts/
docs/
out/
demo/
showcase/

# python and tool noise
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.venv/
venv/

# local state and editors
.git/
.gitignore
*.log
.DS_Store
Thumbs.db
