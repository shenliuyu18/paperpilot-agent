# PaperPilot works without any key in offline demo mode.
# From v6.2 you can also configure the model in the UI (top bar -> 模型设置);
# values saved there override the variables below.
# To enable automatic extraction/translation for uploaded PDFs, provide any
# OpenAI-compatible Chat Completions endpoint.

PAPERPILOT_LLM_API_KEY=
PAPERPILOT_LLM_BASE_URL=https://api.openai.com/v1
PAPERPILOT_LLM_MODEL=gpt-4o-mini
PAPERPILOT_LLM_TIMEOUT=60
# Floor for long completions (800+ output tokens: 简报、精读、对比、问答、Copilot).
# A premature ReadTimeout silently degrades those to offline text. Only applies
# while PAPERPILOT_LLM_TIMEOUT is left at the 60 s default: any timeout you set is
# honoured verbatim, in both directions.
PAPERPILOT_LLM_LONG_TIMEOUT=180
PAPERPILOT_LLM_RETRIES=1

# UI-saved model settings (v6.2). The form is stored in llm_settings.json and
# the key in a separate secrets file; both stay out of the repository and the
# delivery package.
# PAPERPILOT_LLM_SETTINGS_FILE=/absolute/path/llm_settings.json
# PAPERPILOT_LLM_SETTINGS_SECRETS_FILE=/absolute/path/llm_settings.secrets.json
# Set to 0 on shared/public instances: the key then lives in process memory
# only, is never written to disk and never echoed back (the ModelScope image
# ships this as the default).
# PAPERPILOT_LLM_PERSIST_KEY=1
# Required only when you point the app at a loopback / intranet gateway such as
# Ollama or vLLM. Public instances keep this off so the configured address
# cannot reach private networks.
# PAPERPILOT_ALLOW_PRIVATE_LLM=0

# Optional embedding rerank for evidence Q&A. Off by default; requires the
# model service to expose an OpenAI-compatible /embeddings endpoint.
PAPERPILOT_EMBEDDINGS=0
PAPERPILOT_EMBEDDING_MODEL=text-embedding-3-small

# Optional: contact email for the Crossref polite pool.
PAPERPILOT_CONTACT_EMAIL=

# Background scheduler for saved search subscriptions. Off by default: the
# scheduler runs in a single background thread of the app process, so a
# multi-worker deployment would run the same subscription more than once.
# Set to 1 to let subscriptions run on their own interval.
# PAPERPILOT_SCHEDULER=0

# Optional public translation settings. Without a model, PaperPilot uses
# MyMemory for section translation. A valid email can raise the public quota.
# The selected text is sent to the public translation service; avoid
# confidential papers when using this mode.
PAPERPILOT_TRANSLATE_EMAIL=
PAPERPILOT_TRANSLATE_PUBLIC_MAX=7000

# Volcengine Ark example (OpenAI-compatible):
# PAPERPILOT_LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# PAPERPILOT_LLM_MODEL=doubao-seed-1-6-250615
